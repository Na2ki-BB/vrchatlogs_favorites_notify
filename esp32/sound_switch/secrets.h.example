#pragma once
// Template for secrets.h. Copy this file to secrets.h and fill in real values.
//   cp secrets.h.example secrets.h
// secrets.h is gitignored so your Wi-Fi password is never committed.

#define WIFI_SSID "YOUR_WIFI_SSID"      // 2.4GHz SSID (ESP32-C3 has no 5GHz)
#define WIFI_PASS "YOUR_WIFI_PASSWORD"
#define PI_HOST   "192.168.0.10"        // Raspberry Pi LAN IP (`hostname -I`)
#define PI_PORT   8099                  // must match SOUND_API_ADDR on the Pi
